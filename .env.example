# ZipLink configuration. Every variable is optional; defaults are shown.
# ZipLink needs no database or third-party signaling service: session state
# and signaling live in the Next.js server process.

# --- Sessions -------------------------------------------------------------
# Minutes a sender waits for a receiver before the code expires (1–1440).
SESSION_WAIT_MINUTES=30
# Wrong-code attempts allowed per client IP per 10 minutes.
JOIN_FAILURE_LIMIT=10
# Sessions a single IP may create per 10 minutes.
CREATE_SESSION_LIMIT=30
# Salt for hashing client IPs used as rate-limit keys. Set a random value.
RATE_LIMIT_SALT=change-me

# --- ICE / NAT traversal --------------------------------------------------
# Comma-separated STUN URLs. Unset = public Google + Cloudflare STUN.
# Set to an empty value to disable STUN (same-LAN-only deployments).
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Optional TURN relay for restrictive networks (comma-separated URLs).
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# Either a shared secret (coturn `use-auth-secret`, recommended: short-lived credentials)…
# TURN_SECRET=
# TURN_TTL_SECONDS=21600
# …or static credentials.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# --- Site ------------------------------------------------------------------
# Public URL of the deployment (canonical links, sitemap, Open Graph images).
# Must be set at BUILD time: pages are prerendered and NEXT_PUBLIC_* values are inlined.
# NEXT_PUBLIC_SITE_URL=https://ziplink.example.com
